[Unit]
Description=chex-trek pipeline: timer for chextrek-pipeline-poll.service (spec #58/#68)

[Timer]
# Runs once shortly after boot/login-manager-start (covers the lingering-enabled, nobody-logged-in
# case - spec #58's whole point), then again every @@INTERVAL@@ after the *previous run finished*
# (OnUnitActiveSec, not a wall-clock OnCalendar grid) - a poll tick that overruns one interval
# (e.g. a backlog of several commits, each a full suite run) never causes two to pile up: the next
# one is scheduled relative to completion, and systemd additionally refuses to start a second
# instance of the same (already fully-processed-or-not, singleton) service unit while one is still
# active - see docs/dev-setup.md's "AFK trigger" section for the full no-overlap argument.
OnBootSec=5min
OnUnitActiveSec=@@INTERVAL@@
# Reboot survival (spec #58 AC): a tick missed entirely while Unicron was off (not just delayed)
# still fires once, shortly after the next boot, instead of silently waiting a full interval more.
Persistent=true

[Install]
WantedBy=timers.target
